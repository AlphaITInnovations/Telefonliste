# ─────────────────────────────────────────────────────────────────────────────
# Alpha Telefonliste – Konfiguration (Kopie als .env anlegen, NIE committen)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-seitig (Vite-Dev-Proxy / nginx) – landet NICHT im Browser ─────────
# AlphaCore (Directus) – Token NUR mit Leserechten auf die Collection
DIRECTUS_URL=
DIRECTUS_TOKEN=
# Nur für lokale Tests gegen ein internes Zertifikat auf false setzen
DIRECTUS_VERIFY_SSL=true

# ── Frontend (VITE_-Prefix = öffentlich im Bundle, keine Secrets!) ──────────
# true = Beispieldaten statt AlphaCore
VITE_USE_MOCK=false

VITE_COLLECTION=mitarbeitende
# Aktiv-Filter: läuft serverseitig in Directus (Werte kommagetrennt)
VITE_STATUS_FIELD=status
VITE_STATUS_VALUES=aktiv
# Am letzten Arbeitstag noch in der Liste, danach nicht mehr (leer = aus)
VITE_EXIT_DATE_FIELD=exit_date

# Geladen werden AUSSCHLIESSLICH diese Felder (+ technische id).
# ACHTUNG: „Position" in der Liste = AlphaCore-Feld job_title („Titel"),
# NICHT das AlphaCore-Feld „position" (Rollen-Kategorie).
VITE_FIELD_FIRST_NAME=first_name
VITE_FIELD_LAST_NAME=last_name
VITE_FIELD_EMAIL=email
VITE_FIELD_JOB_TITLE=job_title
VITE_FIELD_PHONE=phone
VITE_FIELD_MOBILE=mobile
# Relationen mit Punkt-Notation (Anzeigefeld der verknüpften Collection).
# company → firmen, location → niederlassungen. Der Token braucht dafür Read
# auf firmen.name und niederlassungen.name, sonst werden die Felder ausgeblendet.
# Leer lassen = Filter/Anzeige ausgeblendet.
VITE_FIELD_COMPANY=company.name
VITE_FIELD_LOCATION=location.name
